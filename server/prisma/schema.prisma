generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TruckStatus {
  AVAILABLE
  ASSIGNED
  ON_TRIP
  MAINTENANCE
  INACTIVE
}

enum TripStage {
  EN_ROUTE_TO_PORT
  CONTAINER_PICKED_UP
  EN_ROUTE_TO_CUSTOMER
  ARRIVED_AT_CUSTOMER
  DELIVERED
  RETURNING_EMPTY
  EMPTY_RETURNED
}

enum TripExpenseType {
  MAINTENANCE
  FUEL
}

enum ContainerSize {
  FT_20
  FT_40
}

enum ContainerType {
  DRY
  REFRIGERATED
  OPEN_TOP
  FLAT_RACK
  TANK
  OTHER
}

enum ClearanceStatus {
  PENDING
  CLEARED
  ON_HOLD
  REJECTED
}

enum DocumentStatus {
  DRAFT
  ISSUED
  CANCELLED
  EXPIRED
  FAILED
}

enum ClearanceSource {
  MANUAL
  OFFICIAL_INTEGRATION
}

enum DocumentSource {
  INTERNAL_DRAFT
  MANUAL_ENTRY
  OFFICIAL_INTEGRATION
}

enum IntegrationProvider {
  FASAH
  BAYAN
  NAQL
  RABIT
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  DEGRADED
  UNKNOWN
}

enum UserRole {
  ADMIN
  DRIVER
}

enum TripType {
  PORT
  DOMESTIC
}

enum BillingStatus {
  UNBILLED
  INVOICED
  PAID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Truck {
  id               String      @id @default(cuid())
  fleetNumber      String      @unique
  plateNumber      String      @unique
  serialNumber     String      @unique
  model            String
  status           TruckStatus @default(AVAILABLE)
  assignedDriverId String?
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  trips            Trip[]
  assignedDriver   Driver?     @relation("AssignedTrucks", fields: [assignedDriverId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assignedDriverId])
  @@index([deletedAt])
}

model Driver {
  id             String    @id @default(cuid())
  name           String
  nationalId     String    @unique
  phone          String
  passportNumber String?   @unique
  licenseNumber  String?   @unique
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  trips          Trip[]
  assignedTrucks Truck[]   @relation("AssignedTrucks")
  user           User?

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(DRIVER)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  driverId     String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  driver       Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  sessions     Session[]

  @@index([role])
  @@index([isActive, deletedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AdminSetupClaim {
  id        String   @id
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Customer {
  id        String        @id @default(cuid())
  name      String        @unique
  phone     String?
  email     String?
  address   String?
  taxNumber String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  trips     Trip[]
  rates     CompanyRate[]
  invoices  Invoice[]

  @@index([name])
}

model Port {
  id         String             @id @default(cuid())
  name       String             @unique
  city       String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  clearances CustomsClearance[]
  trips      Trip[]

  @@index([city])
}

model Container {
  id              String             @id @default(cuid())
  containerNumber String             @unique
  size            ContainerSize
  type            ContainerType
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  clearances      CustomsClearance[]
  trips           Trip[]

  @@index([type, size])
}

model CustomsClearance {
  id                 String                @id @default(cuid())
  declarationNumber  String                @unique
  status             ClearanceStatus       @default(PENDING)
  source             ClearanceSource       @default(MANUAL)
  clearedAt          DateTime?
  vesselName         String?
  shippingSealNumber String?
  containerId        String
  portId             String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  container          Container             @relation(fields: [containerId], references: [id], onDelete: Restrict)
  port               Port                  @relation(fields: [portId], references: [id], onDelete: Restrict)
  trip               Trip?
  attachments        OperationAttachment[]

  @@index([status, clearedAt])
  @@index([portId, createdAt])
}

model Trip {
  id                  String             @id @default(cuid())
  operationAt         DateTime           @default(now())
  tripType            TripType           @default(PORT)
  originLocation      String?
  deliveryDestination String
  cargoDescription    String?
  cargoWaybillNumber  String?
  clientRate          Decimal?           @db.Decimal(12, 2)
  driverFee           Decimal?           @db.Decimal(12, 2)
  billingStatus       BillingStatus      @default(UNBILLED)
  invoiceId           String?
  emptyReturnDueAt    DateTime?
  emptyReturnedAt     DateTime?
  eirReceiptNumber    String?
  freeTimeEndsAt      DateTime?
  driverAcceptedAt    DateTime?
  currentStage        TripStage?
  truckId             String?
  truckFleetNumber    String
  truckPlateNumber    String
  truckSerialNumber   String
  truckModel          String
  driverId            String
  customerId          String
  portId              String?
  containerId         String?
  customsClearanceId  String?            @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  truck               Truck?             @relation(fields: [truckId], references: [id], onDelete: SetNull)
  driver              Driver             @relation(fields: [driverId], references: [id], onDelete: Restrict)
  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  port                Port?              @relation(fields: [portId], references: [id], onDelete: Restrict)
  container           Container?         @relation(fields: [containerId], references: [id], onDelete: Restrict)
  customsClearance    CustomsClearance?  @relation(fields: [customsClearanceId], references: [id], onDelete: Restrict)
  invoice             Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  transportDocument   TransportDocument?
  stageUpdates        TripStageUpdate[]
  expenses            TripExpense[]

  @@index([operationAt])
  @@index([tripType, operationAt])
  @@index([billingStatus])
  @@index([invoiceId])
  @@index([customerId, operationAt])
  @@index([portId, operationAt])
  @@index([emptyReturnDueAt, emptyReturnedAt])
  @@index([truckId, operationAt])
  @@index([containerId, operationAt])
  @@index([driverId, driverAcceptedAt])
}

model CompanyRate {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  origin      String
  destination String
  cargoType   String?
  price       Decimal  @db.Decimal(12, 2)
  driverCost  Decimal? @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
  @@index([origin, destination])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  status        InvoiceStatus @default(ISSUED)
  subtotal      Decimal       @db.Decimal(12, 2)
  taxRate       Decimal       @default(15.00) @db.Decimal(5, 2)
  taxAmount     Decimal       @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  trips         Trip[]

  @@index([customerId, issueDate])
  @@index([status])
}

model TripExpense {
  id          String                @id @default(cuid())
  tripId      String
  amount      Decimal               @db.Decimal(12, 2)
  type        TripExpenseType
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  trip        Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  attachments OperationAttachment[]

  @@index([tripId, createdAt])
}

model TripStageUpdate {
  id          String    @id @default(cuid())
  tripId      String
  stage       TripStage
  completedAt DateTime  @default(now())
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, stage])
  @@index([tripId, completedAt])
}

model TransportDocument {
  id                String                @id @default(cuid())
  documentNumber    String?               @unique
  status            DocumentStatus        @default(DRAFT)
  source            DocumentSource        @default(INTERNAL_DRAFT)
  issuedAt          DateTime?
  pdfUrl            String?
  externalReference String?
  tripId            String                @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  trip              Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  attachments       OperationAttachment[]

  @@index([status, issuedAt])
}

model FasahAppointment {
  id                     String                @id @default(cuid())
  bookingReferenceNumber String                @unique
  operatorTicketNumber   String?
  zoneGateName           String?
  portContractorId       String?
  portContractorName     String?
  portName               String?
  appointmentDate        DateTime?             @db.Date
  appointmentTime        String?
  vehiclePlateNumber     String?
  vehiclePlateType       String?
  vehicleColor           String?
  vehicleRefId           String?
  vehicleSerialId        String?
  vehicleModel           String?
  driverName             String?
  driverMobileNumber     String?
  driverLicenseNumber    String?
  entryLocation          String?
  entryBlNumber          String?
  entryDeclarationNumber String?
  entryContainerNumber   String?
  entryCargoType         String?
  entrySerialNumber      String?
  exitLocation           String?
  exitBlNumber           String?
  exitDeclarationNumber  String?
  exitContainerNumber    String?
  exitCargoType          String?
  exitSerialNumber       String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  attachments            OperationAttachment[]

  @@index([appointmentDate, createdAt])
  @@index([vehiclePlateNumber])
  @@index([exitDeclarationNumber])
  @@index([exitContainerNumber])
}

model OperationAttachment {
  id                  String             @id @default(cuid())
  originalName        String
  contentType         String
  size                Int
  data                Bytes
  clearanceId         String?
  transportDocumentId String?
  tripExpenseId       String?
  fasahAppointmentId  String?
  createdAt           DateTime           @default(now())
  clearance           CustomsClearance?  @relation(fields: [clearanceId], references: [id], onDelete: Cascade)
  transportDocument   TransportDocument? @relation(fields: [transportDocumentId], references: [id], onDelete: Cascade)
  tripExpense         TripExpense?       @relation(fields: [tripExpenseId], references: [id], onDelete: Cascade)
  fasahAppointment    FasahAppointment?  @relation(fields: [fasahAppointmentId], references: [id], onDelete: Cascade)

  @@index([clearanceId, createdAt])
  @@index([transportDocumentId, createdAt])
  @@index([tripExpenseId, createdAt])
  @@index([fasahAppointmentId, createdAt])
}

model IntegrationHealth {
  id        String              @id @default(cuid())
  provider  IntegrationProvider @unique
  status    IntegrationStatus   @default(UNKNOWN)
  checkedAt DateTime?
  message   String?
  updatedAt DateTime            @updatedAt
}
